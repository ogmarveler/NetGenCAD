<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>link</TrimMode>
		<SignAssembly>True</SignAssembly>
		<Platforms>x64;ARM64</Platforms>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
	  <DebugType>none</DebugType>
	  <IsTrimmable>True</IsTrimmable>
	  <Optimize>True</Optimize>
	  <IsAotCompatible>True</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
	  <DebugType>none</DebugType>
	  <IsTrimmable>True</IsTrimmable>
	  <Optimize>True</Optimize>
	  <IsAotCompatible>True</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
	  <DebugType>none</DebugType>
	  <IsTrimmable>True</IsTrimmable>
	  <DebugSymbols>false</DebugSymbols>
	  <IsAotCompatible>True</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
	  <DebugType>none</DebugType>
	  <IsTrimmable>True</IsTrimmable>
	  <DebugSymbols>false</DebugSymbols>
	  <IsAotCompatible>True</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.89" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
		<PackageReference Include="SkiaSharp" Version="4.153.1" />
	</ItemGroup>

</Project>
