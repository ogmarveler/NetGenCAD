<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>link</TrimMode>
		<SignAssembly>True</SignAssembly>
		<Platforms>x64;ARM64</Platforms>
		<IncludeHttpRuleProtos>true</IncludeHttpRuleProtos>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
	  <DebugType>none</DebugType>
	  <IsAotCompatible>True</IsAotCompatible>
	  <IsTrimmable>True</IsTrimmable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
	  <DebugType>full</DebugType>
		<DebugSymbols>True</DebugSymbols>
	  <IsAotCompatible>True</IsAotCompatible>
	  <IsTrimmable>True</IsTrimmable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
	  <DebugType>none</DebugType>
	  <DebugSymbols>false</DebugSymbols>
	  <IsAotCompatible>True</IsAotCompatible>
	  <IsTrimmable>True</IsTrimmable>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
	  <DebugType>none</DebugType>
	  <DebugSymbols>false</DebugSymbols>
	  <IsAotCompatible>True</IsAotCompatible>
	  <IsTrimmable>True</IsTrimmable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" Exclude="Assets\**\*.axaml" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Remove="Assets\Guides\Readme.markdown" />
		<AvaloniaResource Remove="Assets\Images\axisCreation.png" />
		<AvaloniaResource Remove="Assets\Images\axisCreationDark.png" />
		<AvaloniaResource Remove="Assets\Images\bullionBars.png" />
		<AvaloniaResource Remove="Assets\Images\bullionBarsCreateDark.png" />
		<AvaloniaResource Remove="Assets\Images\coilCreateDark.png" />
		<AvaloniaResource Remove="Assets\Images\coin.png" />
		<AvaloniaResource Remove="Assets\Images\coinCreateDark.png" />
		<AvaloniaResource Remove="Assets\Images\dataPyramid.png" />
		<AvaloniaResource Remove="Assets\Images\hydraCollector.PNG" />
		<AvaloniaResource Remove="Assets\Images\redAlertTeslaCoil.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.2.0" />
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.2.0" />
		<PackageReference Include="Markdown.Avalonia.Tight" Version="12.0.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
		<PackageReference Include="ReactiveUI" Version="28.0.0" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.1.9" />
		<PackageReference Include="ReactiveUI.Avalonia.Microsoft.Extensions.DependencyInjection" Version="12.1.9" />
		<PackageReference Include="System.Reactive" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Assets\Images\logo-large.png" Pack="True" PackagePath="logo-large.png" />
		<ProjectReference Include="..\..\NetGenCAD.Core\NetGenCAD.Core.csproj" />
		<ProjectReference Include="..\..\NetGenCAD.Designer\NetGenCAD.Designer.csproj" />
		<Compile Update="Views\MainView.axaml.cs">
		  <DependentUpon>MainView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\ShapeView.axaml.cs">
		  <DependentUpon>ShapeView.axaml</DependentUpon>
		</Compile>
		<None Update="Data\netgencad.db">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Scad\Axes\axis_preview.scad">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Scad\Axes\axes.scad">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Scad\Images\logo-large.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Scad\Solids\object.scad">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Assets\Images\bullionBarsCreateDark.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </None>
	  <None Update="Assets\Images\coin.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </None>
	  <None Update="Assets\Images\dataPyramid.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Assets\Images\axisCreationDark.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
