<Window
    x:Class="NetGenCAD.UI.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NetGenCAD.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:NetGenCAD.UI.Views"
    xmlns:vm="using:NetGenCAD.UI.ViewModels"
    Title="{Binding Version, StringFormat='NetGenCAD {0}'}"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    x:CompileBindings="True"
    x:DataType="vm:MainWindowViewModel"
    Background="{DynamicResource WindowBackground}"
    Icon="/Assets/Images/logo.png"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <DockPanel DockPanel.Dock="Top">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="5" Margin="8,0">
            <ComboBox ItemsSource="{Binding ApiAddress}" SelectedIndex="0" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" Padding="10,5"/>
            <Button Background="Transparent" Command="{Binding CheckApiCommand}" ToolTip.Tip="{Binding ApiStatus}" AutomationProperties.Name="{Binding ApiStatus}" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse Width="12" Height="12" Fill="{Binding ApiStatusBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ApiStatusLabel}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
        <Menu>
            <!--  File and Folder Explorer  -->
            <MenuItem Header="_Open">
                <MenuItem Command="{Binding OpenFolderCommand}" Header="_SCAD Folder">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource folder_open_regular}" />
                    </MenuItem.Icon>
                </MenuItem>
				<ToolTip.Tip>
					<TextBlock Text="Opens the folder containing the SCAD assets and database." />
				</ToolTip.Tip>
            </MenuItem>
            <!--  Create Axes, Object, or Shape  -->
            <MenuItem Header="_Create">
                <MenuItem Command="{Binding NewAxesCommand}" Header="_Axes">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource arrow_expand_regular}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding NewObjectCommand}" Header="_Object">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource cube_regular}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding NewShapeCommand}" Header="_Shape">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource select_object_regular}" />
                    </MenuItem.Icon>
                </MenuItem>
				<ToolTip.Tip>
					<TextBlock Text="Create custom axes, objects, and/or custom shapes." />
				</ToolTip.Tip>
            </MenuItem>
            <!--  Change Theme  -->
            <MenuItem Header="_Appearance">
                <MenuItem Command="{Binding ToggleCommand}" Header="_Switch Theme">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource dark_theme_regular}" />
                    </MenuItem.Icon>
                </MenuItem>
				<ToolTip.Tip>
					<TextBlock Text="Switch between Dark and Light background themes. Default is System." />
				</ToolTip.Tip>
            </MenuItem>
			<!--  Guides  -->
            <MenuItem Header="_Guides">
                <MenuItem Command="{Binding MainViewCommand}" Header="_Getting Started">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource book_question_mark_regular}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding AxisViewCommand}" Header="_Custom Axis">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource book_question_mark_regular}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding DesignerViewCommand}" Header="_Object Designer">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource book_question_mark_regular}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding ShapeViewCommand}" Header="_Shape Designer">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource book_question_mark_regular}" />
                    </MenuItem.Icon>
                </MenuItem>
				<MenuItem Command="{Binding ApiGuideCommand}" Header="_Local API">
					<MenuItem.Icon>
						<PathIcon Data="{StaticResource book_question_mark_regular}" />
					</MenuItem.Icon>
				</MenuItem>
				<ToolTip.Tip>
					<TextBlock Text="Tutorials on how to use each module within NetGenCAD" />
				</ToolTip.Tip>
            </MenuItem>
			<!-- Refresh  -->
			<MenuItem Command="{Binding RefreshAllCommand}" Header="_Refresh">
				<MenuItem.Icon>
					<PathIcon Data="{StaticResource arrow_sync_circle_regular}" />
				</MenuItem.Icon>
				<ToolTip.Tip>
					<TextBlock Text="Updates the UI with any data that has been created from API usage" />
				</ToolTip.Tip>
			</MenuItem>
		</Menu>
		</DockPanel>

		<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
			<ContentControl
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{Binding MainViewContent}" />
        </ScrollViewer>

    </DockPanel>
</Window>
